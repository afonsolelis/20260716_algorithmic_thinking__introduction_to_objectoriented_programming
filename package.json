{
  "name": "imobiliaria-rm",
  "version": "1.0.0",
  "description": "Imobiliária R.M — sistema de orçamento de aluguel (TypeScript/Node)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/server.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "tsx src/server/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:load": "rm -f data/loadtest.db && start-server-and-test \"PORT=3099 DB_PATH=./data/loadtest.db npm start\" http://localhost:3099 \"LOAD_TEST_URL=http://localhost:3099 node tests/load/orcamentos.load.mjs\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests eslint.config.js",
    "lint:fix": "eslint src tests eslint.config.js --fix"
  },
  "dependencies": {
    "express": "^4.21.2",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.9",
    "autocannon": "^8.0.0",
    "concurrently": "^9.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-security": "^4.0.1",
    "pa11y-ci": "^4.1.1",
    "start-server-and-test": "^3.0.11",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
